# Casos de las guardas (src/core/guard). Dos formas:
#   {segment, output, invalid}: guard::invalid_output.
#   {marked, types, protected?, output?, disabled?, kept | rejection}: guard::apply. «marked» es el
#   segmento con cada edición escrita [de|a]; types, el tipo dado a mano de cada una (sin clasificador);
#   protected, los tramos protegidos como subcadenas; kept, los índices de las ediciones que quedan.
{"marked": "Hola[|,] Ana, ¿vienes mañana a la fiesta de esta noche?", "types": ["OTRO"], "kept": [], "note": "coma añadida"}
{"marked": "[haber|a ver,] si vienes mañana a casa de mis padres", "types": ["HABER_A_VER"], "kept": [], "note": "coma añadida dentro de otra edición"}
{"marked": "Los clientes[,|] recibirán el pedido mañana por la tarde.", "types": ["COMA_SOBRA"], "kept": [0], "note": "quitar una coma sí está en el catálogo"}
{"marked": "Mañana te llamo para hablar del proyecto[|.]", "types": ["OTRO"], "kept": [], "note": "punto final añadido"}
